TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# Optional: DM / group access control
# TELEGRAM_DM_POLICY=pairing        # pairing | allowlist | open | disabled
# TELEGRAM_DM_ALLOW_FROM=123,456    # csv of user ids
# TELEGRAM_GROUP_POLICY=allowlist   # open | allowlist | disabled
# TELEGRAM_GROUP_ALLOW_FROM=        # csv of user ids
# TELEGRAM_REQUIRE_MENTION=true
# Optional: transport / webhook
# TELEGRAM_TRANSPORT=polling        # polling | webhook
# TELEGRAM_WEBHOOK_URL=https://example.com
# TELEGRAM_WEBHOOK_HOST=127.0.0.1
# TELEGRAM_WEBHOOK_PORT=8787
# TELEGRAM_WEBHOOK_PATH=/telegram
# TELEGRAM_WEBHOOK_SECRET=
# Optional: polling tuning
# TELEGRAM_POLLING_STALL_MS=120000
# Optional: logging / state
# TELEGRAM_LOG_LEVEL=info           # debug | info | warn | error
# TELEGRAM_STATE_FILE=.telegram-state.json
# TELEGRAM_CONFIG=./telegram.json
